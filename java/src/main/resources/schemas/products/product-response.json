{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "sku": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string"
    },
    "stock": {
      "type": "integer"
    },
    "active": {
      "type": "boolean"
    },
    "inStock": {
      "type": "boolean"
    },
    "lowStock": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "price",
    "sku",
    "category",
    "imageUrl",
    "stock",
    "active",
    "inStock",
    "lowStock",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
