# Copy to .env and fill in. Never commit .env.
# Running inside Docker? "localhost" is the container itself: use http://host.docker.internal:3333
BASE_URL=http://localhost:3333
# Endpoint enums carry the version (/v1/...) because /health and /test live outside it
API_BASE_PATH=/api

# Optional: JWT used as-is until AuthApi logs in and replaces it
TOKEN=

# Optional mTLS (PEM files, paths relative to the java/ folder). Leave empty when not required.
TLS_KEY_PATH=
TLS_CERT_PATH=
TLS_CA_PATH=

# Test accounts (one block per account registered in SystemAccounts); USERNAME is the login e-mail
DEFAULT_USER_ID=
DEFAULT_USER_USERNAME=
DEFAULT_USER_PASSWORD=
ADMIN_USER_ID=
ADMIN_USER_USERNAME=
ADMIN_USER_PASSWORD=

# Saves downloaded files to temp/
SAVE_TEST_OUTPUT=false
