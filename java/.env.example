# Copy to .env and fill in. Never commit .env.
BASE_URL=https://api.example.com
API_BASE_PATH=/api
AUTH_SESSION_PATH=/api/auth/login

# Optional: used as-is when set (skips nothing in the login flow; AuthApi overwrites it after a login)
COOKIE=

# Optional mTLS (PEM files, paths relative to the java/ folder). Leave empty when not required.
TLS_KEY_PATH=
TLS_CERT_PATH=
TLS_CA_PATH=

# Identity provider (see AuthApi)
AUTH_APP_ID=
AUTH_LOGIN_ENDPOINT=
AUTH_OAUTH_TOKEN_ENDPOINT=
AUTH_OAUTH_AUTHCODE_ENDPOINT=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_GRANT_TYPE=
AUTH_JWT_HEADER=X-Corp-Auth-Jwt
# Comma-separated cookie names that must come back from the session endpoint
AUTH_SESSION_COOKIES=sessionid

# Test accounts (one block per account registered in SystemAccounts)
DEFAULT_USER_ID=
DEFAULT_USER_USERNAME=
DEFAULT_USER_PASSWORD=
DEFAULT_USER_SECRETKEY=
ADMIN_USER_ID=
ADMIN_USER_USERNAME=
ADMIN_USER_PASSWORD=
ADMIN_USER_SECRETKEY=

# Saves downloaded files to temp/
SAVE_TEST_OUTPUT=false
