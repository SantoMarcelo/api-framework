{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "sku": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "stock": {
          "type": "integer"
        },
        "active": {
          "type": "boolean"
        },
        "inStock": {
          "type": "boolean"
        },
        "lowStock": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "price",
        "sku",
        "category",
        "imageUrl",
        "stock",
        "active",
        "inStock",
        "lowStock",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "movement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "productId": {
          "type": "integer"
        },
        "type": {
          "type": "string",
          "enum": [
            "ENTRY",
            "EXIT",
            "ADJUSTMENT"
          ]
        },
        "quantity": {
          "type": "integer"
        },
        "previousStock": {
          "type": "integer"
        },
        "newStock": {
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "userId": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "product": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "sku": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "sku"
          ],
          "additionalProperties": false
        },
        "user": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "productId",
        "type",
        "quantity",
        "previousStock",
        "newStock",
        "reason",
        "userId",
        "createdAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "product",
    "movement"
  ],
  "additionalProperties": false
}
